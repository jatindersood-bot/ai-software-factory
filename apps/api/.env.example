# Database
DATABASE_URL=postgresql+psycopg2://app:app@localhost:5432/factory

# Queue
REDIS_URL=redis://localhost:6379/0

# Paths (resolved from api dir)
ARTIFACTS_DIR=../../artifacts
WORKSPACES_DIR=../../workspaces

# GitHub (token for API; repo URL and base branch for worker open_pr)
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO_URL=https://github.com/owner/repo.git
GITHUB_BASE_BRANCH=main

# LLM (default provider: openai_compatible)
LLM_PROVIDER=openai_compatible
# Optional base URL for OpenAI-compatible endpoints
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# Temperature for sampling (default 0.2)
LLM_TEMPERATURE=0.2
